# =====================================================
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# =====================================================

# --- Anthropic Claude API ---
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
CLAUDE_MODEL_BULK=claude-sonnet-4-6
CLAUDE_MODEL_SYNTHESIS=claude-opus-4-7

# --- OpenAI (for embeddings only) ---
# Get from https://platform.openai.com
OPENAI_API_KEY=sk-xxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase Postgres ---
# Get from your Supabase project settings
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=xxxxxxxxxxxx
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- YouTube Data API ---
# Get from https://console.cloud.google.com (enable YouTube Data API v3)
YOUTUBE_API_KEY=xxxxxxxxxxxx

# --- Market Data ---
ALPHA_VANTAGE_KEY=xxxxxxxxxxxx
FRED_API_KEY=xxxxxxxxxxxx

# --- Application Settings ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Optional: Error tracking ---
SENTRY_DSN=
