# --- Anthropanthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL_BULK=claude-sonnet-4-6
CLAUDE_MODEL_SYNTHESISic Claude API ---
# Get from https://console.=claude-opus-4-7

# --- OpenAI (embeddings only) ---
# Get from https://platform.openai.com
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase Postgres ---
# Get from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- YouTube Data API ---
# Get from https://console.cloud.google.com (enable YouTube Data API v3)
YOUTUBE_API_KEY=your-youtube-key-here
# Optional: if YouTube starts blocking transcript fetches, set a HTTP(S) proxy here.
YOUTUBE_PROXY_URL=
# Optional: Webshare-style rotating proxies (username/password) for blocked IPs.
YOUTUBE_PROXY_USERNAME=
YOUTUBE_PROXY_PASSWORD=
YOUTUBE_PROXY_RETRIES=5
YOUTUBE_REQUEST_DELAY_SECONDS=1

# --- Market Data (optional for MVP, leave blank for now) ---
ALPHA_VANTAGE_KEY=
FRED_API_KEY=

# --- Application Settings ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Enrichment flags (PHASE TWO — keep OFF for MVP) ---
ENABLE_WHISPER=false
ENABLE_VISUAL_EXTRACTION=false
WHISPER_MODE=api
VISION_MODEL=claude-opus-4-7

# --- Optional: Error tracking ---
SENTRY_DSN=